{
  "manifest_version": 3,
  "name": "PinReach â€“ Where can I get this delivered?",
  "short_name": "PinReach",
  "version": "1.0.0",
  "description": "Product not deliverable to you? PinReach finds where it can be delivered, with price and date, on Flipkart, JioMart, Myntra and Amazon: your relatives' addresses and the nearest of 174 cities.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PinReach",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.flipkart.com/*",
        "https://www.jiomart.com/*",
        "https://www.myntra.com/*",
        "https://www.amazon.in/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "geolocation"
  ],
  "host_permissions": [
    "https://www.flipkart.com/*",
    "https://www.jiomart.com/*",
    "https://www.myntra.com/*",
    "https://www.amazon.in/*",
    "https://1.rome.api.flipkart.com/*"
  ]
}
